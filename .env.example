# --- server ---
PORT=4000
NODE_ENV=development

# --- database ---
# MongoDB Atlas connection string (free M0 cluster is plenty for this)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/anniversary?retryWrites=true&w=majority

# --- auth ---
# long random string — e.g. `openssl rand -hex 32`
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- cookies / cors ---
# the URL your React frontend is served from
CLIENT_ORIGIN=http://localhost:5173
# set to true only once both frontend+backend are on HTTPS in production
COOKIE_SECURE=false
# "lax" works if frontend+backend share a root domain (e.g. app.yourdomain.com
# talking to api.yourdomain.com). Use "none" (and COOKIE_SECURE=true) if they're
# on totally different domains (e.g. vercel.app + onrender.com).
COOKIE_SAME_SITE=lax

# --- seed script only (never stored in the db in plain text) ---
GHEEVAS_PASSWORD=change-me
ALEENA_PASSWORD=change-me
